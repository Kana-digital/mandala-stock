# Vercel ダッシュボード Settings → Environment Variables に設定すること。
# ローカル開発で使う場合は .env.local にコピーしてください。

# ============ 認証 (必須) ============
# 自分以外のアクセスを遮断するゲート
BASIC_AUTH_USER=kana
BASIC_AUTH_PASS=please-change-this-to-strong-passphrase

# ============ 外部 API キー (Phase 2 / 任意) ============
# 設定したものから順に「API 自動入力」ボタンが有効になる
# 未設定の API は呼び出し時にエラーで返る（手動入力へフォールバック）

# J-Quants（株価・財務）— 無料プランあり
# https://jpx-jquants.com マイページで Refresh Token を取得（30日有効）
JQUANTS_REFRESH_TOKEN=

# EDINET（大量保有報告書）
# https://api.edinet-fsa.go.jp で利用申請後 Subscription Key を発行
EDINET_SUBSCRIPTION_KEY=

# FRED（米国マクロ指標）
# https://fred.stlouisfed.org/docs/api/api_key.html で無料発行
FRED_API_KEY=

# e-Stat（日本政府統計）
# https://www.e-stat.go.jp/api でアプリ登録すると AppId 発行
ESTAT_APP_ID=

# NewsAPI（ニュース）
# https://newsapi.org の Developer プランは無料・100req/日
NEWSAPI_KEY=
